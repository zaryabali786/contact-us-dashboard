{
  "name": "contact-management-dashboard-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Contact Management Dashboard - Angular & TypeScript Frontend with Flask REST API",
  "scripts": {
    "start:frontend": "cd frontend && npm start",
